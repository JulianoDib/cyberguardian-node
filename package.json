{
  "name": "cyberguardian-node",
  "version": "1.0.0",
  "description": "NIDS distribuido (Tema 10 - PDP/Multivix): Gateway TCP, Kafka, workers com Relogio de Lamport e eleicao Bully.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "teste:produtor": "node --disable-warning=TimeoutNegativeWarning dist/testes/produtor-teste.js",
    "teste:consumidor": "node --disable-warning=TimeoutNegativeWarning dist/testes/consumidor-teste.js",
    "demo:problema": "node demonstracoes/problema-sem-framing.mjs",
    "demo:solucao": "node demonstracoes/solucao-com-framing.mjs",
    "gateway": "node --disable-warning=TimeoutNegativeWarning dist/gateway/servidor.js",
    "sensor": "node --disable-warning=TimeoutNegativeWarning dist/sensor/simulador.js",
    "worker": "node --disable-warning=TimeoutNegativeWarning dist/worker/worker.js",
    "demo:lamport": "node demonstracoes/ordenar-auditoria.mjs",
    "demo:entrega": "node demonstracoes/conferir-entrega.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@types/node": "^26.4.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "kafkajs": "^2.2.4"
  }
}
