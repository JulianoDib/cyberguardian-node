# Variaveis de ambiente / segredos
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
logs/

# Dados locais de execucao (volumes do Docker, banco, etc.)
data/

# Arquivos de sistema operacional
Thumbs.db
Desktop.ini
.DS_Store

# Configuracao pessoal de editor
.vscode/*
!.vscode/extensions.json
.idea/

